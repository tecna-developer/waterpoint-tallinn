{
  "name": "waterpoint-tallinn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lock:check": "npx -y npm@10 ci --dry-run",
    "lock:fix": "npx -y npm@10 install --package-lock-only",
